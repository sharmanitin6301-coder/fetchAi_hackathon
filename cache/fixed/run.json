        "originalHtml": "<!DOCTYPE html>\n<!-- Fixed: Added lang=\"en\" attribute to html -->\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Brew &amp; Bean Weekly</title>\n  <style>\n    * { box-sizing: border-box; margin: 0; padding: 0; }\n    body {\n      font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;\n      background: #f7f9fa;\n      color: #1a202c;\n      padding: 0 0 60px 0;\n    }\n    .promo-banner {\n      background: #e2e8f0;\n      color: #334155;\n      padding: 10px 20px;\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      font-size: 14px;\n    }\n    .banner-close {\n      background: none;\n      border: none;\n      cursor: pointer;\n      padding: 4px;\n      display: flex;\n      align-items: center;\n    }\n    .banner-close:focus-visible {\n      outline: 2px solid #1e3a8a;\n      outline-offset: 2px;\n      border-radius: 4px;\n    }\n    .banner-close svg {\n      width: 18px;\n      height: 18px;\n      stroke: #475569;\n    }\n    .header-bar {\n      background: #ffffff;\n      border-bottom: 1px solid #e2e8f0;\n      padding: 16px 24px;\n    }\n    .brand {\n      font-weight: 700;\n      font-size: 18px;\n      color: #7c2d12;\n    }\n    .container {\n      max-width: 600px;\n      margin: 40px auto 0 auto;\n      background: #ffffff;\n      border-radius: 12px;\n      overflow: hidden;\n      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.08);\n    }\n    .hero-container {\n      width: 100%;\n      height: 220px;\n      background: #fed7aa;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n    }\n    .hero-container img {\n      width: 100%;\n      height: 100%;\n      object-fit: cover;\n    }\n    .content {\n      padding: 32px;\n    }\n    h1 {\n      font-size: 26px;\n      color: #27272a;\n      margin-bottom: 6px;\n    }\n    /* Fixed: h2 heading following h1 for correct hierarchy */\n    h2 {\n      font-size: 16px;\n      color: #52525b;\n      font-weight: 400;\n      margin-bottom: 24px;\n    }\n    .form-group {\n      margin-bottom: 16px;\n    }\n    /* Fixed: visible accessible form label */\n    .form-label {\n      display: block;\n      font-size: 14px;\n      font-weight: 600;\n      color: #27272a;\n      margin-bottom: 6px;\n    }\n    input[type=\"email\"] {\n      width: 100%;\n      padding: 12px 14px;\n      font-size: 15px;\n      border: 1px solid #cbd5e1;\n      border-radius: 6px;\n      background: #ffffff;\n    }\n    input[type=\"email\"]:focus-visible {\n      outline: 2px solid #9a3412;\n      outline-offset: 1px;\n      border-color: #9a3412;\n    }\n    /* Fixed: text contrast exceeds 4.5:1 (#52525b on #ffffff is ~7.2:1) */\n    .helper-text {\n      color: #52525b;\n      font-size: 13px;\n      margin-top: 8px;\n    }\n    /* Fixed: Real button with explicit focus-visible outline */\n    .btn-subscribe {\n      display: inline-block;\n      width: 100%;\n      text-align: center;\n      background: #9a3412;\n      color: #ffffff;\n      font-weight: 600;\n      font-size: 15px;\n      padding: 12px 16px;\n      border-radius: 6px;\n      border: none;\n      cursor: pointer;\n      user-select: none;\n    }\n    .btn-subscribe:hover {\n      background: #7c2d12;\n    }\n    .btn-subscribe:focus-visible {\n      outline: 3px solid #1e3a8a;\n      outline-offset: 2px;\n    }\n    .success-message {\n      display: none;\n      margin-top: 20px;\n      padding: 14px;\n      border-radius: 6px;\n      background: #ecfdf5;\n      color: #065f46;\n      font-weight: 600;\n      font-size: 15px;\n      text-align: center;\n    }\n  </style>\n</head>\n<body>\n  <!-- Fixed: added aside landmark for announcements -->\n  <aside id=\"promoBanner\" class=\"promo-banner\" aria-label=\"Special announcements\">\n    <span>Special edition: The Ethiopian Yir